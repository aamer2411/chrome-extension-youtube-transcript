{
   "manifest_version": 3,
   "name": "YouTube Transcript",
   "version": "1.0.0",
   "description": "One click saves a YouTube video's transcript as a text file named after the video.",
   "icons": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "64": "icons/icon_64.png",
      "128": "icons/icon_128.png"
   },
   "content_scripts": [ {
      "matches": [ "https://www.youtube.com/*" ],
      "css": [ "content.css" ],
      "js": [ "content.js" ],
      "run_at": "document_idle"
   } ]
}
